{
  "name": "kiwibit_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/apply-mcp-provider-patch.mts",
    "prepare": "husky",
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && next build --webpack",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:admin": "node prisma/seed-admin.mjs",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:mcp-provider": "node tests/security/mcp-oauth-provider.test.mts",
    "test:mcp-provider:postgres": "bash scripts/test-mcp-provider.sh",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern \"docs/design_examples_disabled/**\" --ignore-pattern \"coverage/**\"",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mcp-patch": "node --test tests/security/mcp-provider-patch.test.mts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.19",
    "@better-auth/mcp": "1.7.19",
    "@better-auth/oauth-provider": "1.7.19",
    "@modelcontextprotocol/server": "2.4.0",
    "@posthog/nextjs-config": "^1.11.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.19",
    "dotenv": "^17.4.2",
    "emoji-picker-react": "^5.1.4",
    "ipaddr.js": "^2.5.0",
    "kysely": "0.28.17",
    "lucide-react": "^1.33.0",
    "markdown-it": "^15.0.3",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "posthog-js": "^1.433.5",
    "posthog-node": "^5.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "babel-jest": "^30.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.22.2 <25"
  }
}
