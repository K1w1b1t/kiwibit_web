POSTGRES_DB=kiwibit
POSTGRES_USER=kiwibit
POSTGRES_PASSWORD=kiwibit_dev_password

DATABASE_URL="postgresql://kiwibit:kiwibit_dev_password@localhost:5433/kiwibit?schema=public"
# Password given to every seeded user by `npm run prisma:seed`.
# SEED_USER_PASSWORD is the canonical name; SEED_ADMIN_PASSWORD is accepted too.
SEED_USER_PASSWORD="change_me_local"

# Admin-only seed (prisma/seed-admin.mjs) — used by the CI/CD migration pipeline.
# ADMIN_EMAIL="admin@kiwibit.dev"
# ADMIN_PASSWORD="change_me"

# Optional: verify Supabase's TLS chain against its CA (paste the PEM downloaded
# from Supabase → Settings → Database → SSL Certificate). If unset, SSL is still
# used (encrypted) but the self-signed chain is not verified.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change_me"
NEXTAUTH_URL="http://localhost:3000"

# Public site origin (used for SEO metadata, canonical URLs, sitemap, robots).
NEXT_PUBLIC_SITE_URL="https://www.kiwibit.com.br"

# Discord webhook that receives contact form submissions.
DISCORD_CONTACT_WEBHOOK_URL=""

# Discord webhook that receives backend error (5xx) notifications.
DISCORD_ERROR_WEBHOOK_URL=""

# LinkedIn auto-post — Company Page (issue #81, "global config" destination).
# A single global token/URN for the Kiwibit organization page (Community
# Management API, scope w_organization_social). Reconnect ~every 60 days.
LINKEDIN_COMPANY_ACCESS_TOKEN=""
LINKEDIN_COMPANY_AUTO_POST_ENABLED="false"
LINKEDIN_COMPANY_AUTHOR_URN=""

# LinkedIn auto-post — personal profile: LEGACY. The author's personal post now
# comes from their OWN per-member OAuth connection (opt-in + w_member_social,
# stored encrypted per member — see LINKEDIN_CLIENT_* below), NOT from these env
# vars. Kept only for local testing of the env-based personal path.
LINKEDIN_PERSONAL_ACCESS_TOKEN=""
LINKEDIN_PERSONAL_AUTO_POST_ENABLED="false"
LINKEDIN_PERSONAL_AUTHOR_URN=""

# ─── Object storage (OCI, Always Free) ───────────────────────────────────────
# Provisioned by ../infrastructure (modules/storage), one bucket per environment:
#   kiwibit-media-staging  ->  branch `release` / Vercel Preview
#   kiwibit-media-prod     ->  branch `main`    / Vercel Production
# Read the values with `terraform output` after the apply. Locally, point at the
# staging bucket. Leave empty to disable uploads (the route answers 503 and the
# forms fall back to pasting a URL).
#
# NEVER prefix these with NEXT_PUBLIC_ — the secret key is server-only.
OCI_STORAGE_NAMESPACE=""
OCI_STORAGE_REGION="sa-saopaulo-1"
OCI_STORAGE_BUCKET=""
OCI_S3_ACCESS_KEY_ID=""
OCI_S3_SECRET_ACCESS_KEY=""

# --- LinkedIn (profile photo sync, issue #80) ---------------------------------
# "Sign In with LinkedIn using OpenID Connect" app credentials. The redirect URI
# registered on the LinkedIn app must be exactly:
#   ${NEXT_PUBLIC_SITE_URL}/api/admin/members/linkedin/callback
#
# NEVER prefix these with NEXT_PUBLIC_ — the client secret is server-only.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# 32-byte key (base64) that encrypts the stored access token at rest.
# Generate with: openssl rand -base64 32
LINKEDIN_TOKEN_ENC_KEY=""
