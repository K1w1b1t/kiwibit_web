generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  editor
  member_manager
  member
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(member)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts  Post[]
  member Member?

  @@map("users")
}

model Member {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  name       String
  bio        String?
  avatarUrl  String?  @map("avatar_url")
  /// Bucket key for an uploaded avatar. NULL means the URL is externally hosted
  /// (pasted by hand) and MUST NOT be deleted from the bucket.
  avatarPath String?  @map("avatar_path")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("members")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  repoUrl     String?  @map("repo_url")
  liveUrl     String?  @map("live_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images ProjectImage[]

  @@map("projects")
}

/// Carousel image for a project.
///
/// Ordering is `position`: dense and 0-based, rewritten wholesale inside a
/// transaction on every reorder/delete, so no unique constraint is needed.
/// Exactly one row per project should have `isCover = true` — enforced in the
/// application layer (clear-then-set in a transaction), because a FK to the
/// cover cannot express "and that image belongs to this project" and would add
/// a two-table FK cycle to the existing cascade.
model ProjectImage {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  url         String
  /// Object key inside the storage bucket, needed to delete the object.
  storagePath String   @map("storage_path")
  alt         String?
  position    Int      @default(0)
  isCover     Boolean  @default(false) @map("is_cover")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_images")
}

enum PostStatus {
  draft
  published
}

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  content        String
  authorId       String     @map("author_id") @db.Uuid
  /// Only `published` rows are exposed by the public GET /api/posts.
  status         PostStatus @default(draft)
  /// Set the first time a post is published; kept on unpublish.
  publishedAt    DateTime?  @map("published_at")
  /// Single cover image. Three denormalized columns instead of a shared media
  /// table: `runPaginatedQuery` cannot `include`, and a strict 1:1 needs no join.
  coverImageUrl  String?    @map("cover_image_url")
  coverImagePath String?    @map("cover_image_path")
  coverImageAlt  String?    @map("cover_image_alt")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("posts")
}
